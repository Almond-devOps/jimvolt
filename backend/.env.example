# PostgreSQL. For Aiven use the service (or connection-pool) host, port, user and database,
# and set DB_SSL_CA to the downloaded CA certificate (required for any non-local host).
DB_HOST=localhost
DB_USER=jimvolt_user
DB_PASSWORD=replace-with-the-application-user-password
DB_NAME=jimvolt_db
DB_PORT=5432
# DB_SSL_CA=certs/ca.pem
# Connections per instance (2 on Vercel, 10 elsewhere by default).
# DB_CONNECTION_LIMIT=2
JWT_SECRET=
PORT=5000
FRONTEND_URL=http://localhost:5173
BACHS_API_KEY=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=Jimvolt <no-reply@jimvolt.local>
