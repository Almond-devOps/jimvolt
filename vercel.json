{
  "version": 2,
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "backend/vercel.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "backend/certs/**",
          "backend/config/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "backend/vercel.js"
    },
    {
      "src": "/uploads/(.*)",
      "dest": "backend/vercel.js"
    },
    {
      "src": "/ads/(.*)",
      "dest": "backend/vercel.js"
    },
    {
      "src": "/sellers/(.*)",
      "dest": "backend/vercel.js"
    },
    {
      "src": "/seller/(.*)",
      "dest": "backend/vercel.js"
    },
    {
      "src": "/category/(.*)",
      "dest": "backend/vercel.js"
    },
    {
      "src": "/robots.txt",
      "dest": "backend/vercel.js"
    },
    {
      "src": "/sitemap(.*)\\.xml",
      "dest": "backend/vercel.js"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/index.html"
    }
  ]
}
