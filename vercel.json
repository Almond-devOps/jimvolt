{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "backend": {
      "root": "backend",
      "framework": "express",
      "entrypoint": "vercel.js",
      "bindings": [
        {
          "type": "service",
          "service": "frontend",
          "format": "url",
          "env": "JIMVOLT_FRONTEND_URL"
        }
      ]
    },
    "frontend": {
      "root": "frontend",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/uploads/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/ads/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/sellers/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/seller/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/category/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/robots.txt",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/sitemap.xml",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/sitemap-:part.xml",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
